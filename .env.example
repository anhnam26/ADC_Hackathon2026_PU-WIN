# Preparation template only; application/config loader is not implemented yet.
# Put your real key only in the root .env. Never paste it in chat or commit it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_AUDIO_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_FREE_ONLY=true
OPENROUTER_ALLOW_PAID_FALLBACK=false
OPENROUTER_DATA_COLLECTION=deny
# App-side budgets; server/account/provider limits still apply.
OPENROUTER_REQUESTS_PER_MINUTE=10
OPENROUTER_REQUESTS_PER_DAY=40
OPENROUTER_MAX_RETRIES=1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_OUTPUT_TOKENS=2048

# Graph desktop public client: identifiers only, no client secret/password.
MS_CLIENT_ID=
# Fill tenant ID for organizational account; consumers for personal-only app;
# common only if the app registration supports the corresponding accounts.
MS_TENANT_ID=
MS_REDIRECT_URI=http://localhost
DEMO_SENDER_EMAIL=
ALLOW_REAL_EMAIL_SEND=false

# Relative to project root; only explicitly selected inputs may be accessed.
INPUTS_DIR=inputs/private
OUTPUTS_DIR=outputs
SAVE_RAW_AUDIO=false
